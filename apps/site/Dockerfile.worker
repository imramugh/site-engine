FROM node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
WORKDIR /workspace
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
RUN corepack enable && corepack prepare pnpm@12.10.1 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY patches ./patches
COPY packages/contract ./packages/contract
COPY packages/engine ./packages/engine
COPY packages/checks ./packages/checks
COPY packages/theme-starter ./packages/theme-starter
COPY apps/site ./apps/site
RUN pnpm install --frozen-lockfile --filter @site-engine/site... \
  && pnpm --filter @site-engine/contract build \
  && pnpm --filter @site-engine/engine build \
  && pnpm --filter @site-engine/checks build \
  && pnpm --filter @site-engine/theme-starter build \
  && pnpm --filter @site-engine/site exec playwright install --with-deps chromium \
  && chmod -R a+rX /opt/playwright \
  && mkdir -p /workspace/apps/site/.astro /artifacts \
  && chown -R 10001:10001 /workspace/apps/site/.astro /artifacts
ENV NODE_ENV=production ASTRO_TELEMETRY_DISABLED=1 PREVIEW_ARTIFACT_ROOT=/artifacts PUBLISH_ROLE=preview
USER 10001:10001
WORKDIR /workspace/apps/site
CMD ["sh", "-c", "if [ \"$PUBLISH_ROLE\" = publish-dispatcher ]; then exec node scripts/run-publish-dispatcher.mjs; fi; if [ \"$PUBLISH_ROLE\" = publish ] && [ -n \"$PUBLISH_WEBHOOK_PORT\" ]; then exec node scripts/run-publish-webhook-receiver.mjs; fi; if [ \"$PUBLISH_ROLE\" = publish ]; then exec node scripts/run-publish-worker.mjs; fi; exec node scripts/run-preview-worker.mjs"]
