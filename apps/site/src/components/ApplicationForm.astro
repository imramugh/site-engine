---
interface Props { jobId: string; enabled: boolean }
const { jobId, enabled } = Astro.props;
---
<form data-application-form method="post" action="/api/applications" enctype="multipart/form-data" aria-describedby="application-status">
  <input type="hidden" name="jobId" value={jobId} />
  <p><label for="application-name">Name <input id="application-name" name="name" required maxlength="160" autocomplete="name" disabled={!enabled} /></label></p>
  <p><label for="application-email">Email <input id="application-email" name="email" type="email" required maxlength="254" autocomplete="email" disabled={!enabled} /></label></p>
  <p><label for="application-cover-letter">Cover letter <textarea id="application-cover-letter" name="coverLetter" required maxlength="10000" disabled={!enabled}></textarea></label></p>
  <p><label for="application-resume">Resume (PDF or DOCX, 5 MB maximum) <input id="application-resume" name="resume" type="file" accept="application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,.pdf,.docx" required disabled={!enabled} /></label></p>
  <p><label><input name="consent" type="checkbox" value="true" required disabled={!enabled} /> I consent to the handling of this application.</label></p>
  <p id="application-status" role="status" aria-live="polite"></p>
  <p data-application-error role="alert" hidden></p>
  <button type="submit" disabled={!enabled}>Submit application</button>
</form>
{enabled && <script is:inline src="/application-form.js"></script>}
