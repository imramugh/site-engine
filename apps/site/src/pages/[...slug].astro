---
import Layout from '@site-engine/theme-starter/components/Layout.astro';
import BlockRenderer from '@site-engine/theme-starter/components/BlockRenderer.astro';
import { childrenOf, deriveRoutes } from '@site-engine/engine';
import { localURL, siteHomepageId, siteSnapshot } from '../lib/snapshot.js';
import MotionRuntime from '../components/MotionRuntime.astro';
import { pageHasEnabledMotion, projectThemeBlock, resolveStarterMotion } from '../lib/motion.js';
import { crawlerMode } from '../lib/crawler-config.js';
import { publicOrigin, renderBase } from '../lib/snapshot.js';
import { schemaForRoute } from '../lib/seo.js';
import ApplicationForm from '../components/ApplicationForm.astro';
import InquiryForm from '../components/InquiryForm.astro';
const model = deriveRoutes(siteSnapshot, siteHomepageId);
export function getStaticPaths() { const staticModel = deriveRoutes(siteSnapshot, siteHomepageId); return staticModel.routes.filter((route) => route.path !== '/').map((route) => ({ params: { slug: route.path.slice(1) }, props: { route } })); }
const { route } = Astro.props;
const children = childrenOf(route, model);
const motionEnabled = pageHasEnabledMotion(route.page.blocks);
const applicationsEnabled = renderBase === '/';
const preview = crawlerMode(renderBase) === 'preview';
const searchEnabled = !preview && siteSnapshot.settings.searchEnabled;
const hasVisibleHero = route.page.blocks.some((block) => !block.hidden && block.type === 'hero');
const serviceHeroID = route.page.template === 'service' ? route.page.blocks.find((block) => !block.hidden && block.type === 'hero')?.id : undefined;
const projectedServiceHero = (block: PageBlock): boolean => block.id === serviceHeroID && Boolean(route.page.kicker || route.page.lede) && block.type === 'hero';
const renderedBlock = (block: PageBlock): PageBlock => block.type === 'hero' && projectedServiceHero(block) ? { ...block, ...(route.page.kicker ? { eyebrow: route.page.kicker } : {}), heading: route.page.title, body: route.page.lede ?? route.page.summary } : block;
const analyticsConfigured = !preview && (() => { try { const endpoint = new URL(process.env.PUBLIC_ANALYTICS_ENDPOINT ?? ''); return endpoint.protocol === 'https:' && !endpoint.username && !endpoint.password; } catch { return false; } })();
const AnalyticsHooks = analyticsConfigured ? (await import('../components/AnalyticsHooks.astro')).default : undefined;
type PageBlock = typeof route.page.blocks[number];
const composedInquiry = (block: PageBlock): boolean => Boolean(!block.hidden && block.type === 'contact' && block.inquiryForm && block.contactDetails !== undefined);
const inquiryHeading = (block: PageBlock): string | undefined => block.type === 'contact' && composedInquiry(block) ? block.heading : undefined;
---
<Layout route={route} model={model} snapshot={siteSnapshot} title={route.page.title} description={route.page.seoDescription ?? route.page.summary} motionEnabled={motionEnabled} noindex={preview || route.page.noindex} searchEnabled={searchEnabled} schema={schemaForRoute(route, model, siteSnapshot, publicOrigin)}>
  <nav aria-label="Breadcrumb"><ol>{route.breadcrumbs.map((crumb, index) => <li>{index === route.breadcrumbs.length - 1 ? <span aria-current="page">{crumb.label}</span> : <a href={localURL(crumb.href)}>{crumb.label}</a>}</li>)}</ol></nav>
  {route.page.template === 'service' && !hasVisibleHero && (route.page.kicker || route.page.lede || route.page.lastReviewed) ? <header class="block"><div class="block__inner">{route.page.kicker && <p>{route.page.kicker}</p>}<h1>{route.page.title}</h1><p>{route.page.lede ?? route.page.summary}</p>{route.page.lastReviewed && <p><small>Last reviewed <time datetime={route.page.lastReviewed}>{route.page.lastReviewed.slice(0, 10)}</time></small></p>}</div></header> : !hasVisibleHero && <header class="block"><div class="block__inner"><h1>{route.page.title}</h1><p>{route.page.summary}</p></div></header>}
  {route.page.blocks.map((block) => <>{composedInquiry(block) && <InquiryForm enabled={renderBase === '/'} formId={`${block.id}-inquiry`} heading={inquiryHeading(block)} headingId={`${block.id}-inquiry-title`} topicLabel={block.type === 'contact' ? block.inquiryTopicLabel : undefined} topics={block.type === 'contact' ? block.inquiryTopics : undefined} consentLabel={block.type === 'contact' ? block.inquiryConsentLabel : undefined} />}<BlockRenderer block={renderedBlock(projectThemeBlock(block))} snapshot={siteSnapshot} model={model} motionPreset={resolveStarterMotion(block)} hostInquiryRendered={composedInquiry(block)} inlineEditingDisabled={projectedServiceHero(block)} />{block.id === serviceHeroID && route.page.lastReviewed && <p class="block__inner" data-page-last-reviewed><small>Last reviewed <time datetime={route.page.lastReviewed}>{route.page.lastReviewed.slice(0, 10)}</time></small></p>}{!composedInquiry(block) && !block.hidden && block.type === 'contact' && block.inquiryForm && <InquiryForm enabled={renderBase === '/'} formId={`${block.id}-inquiry`} topicLabel={block.type === 'contact' ? block.inquiryTopicLabel : undefined} topics={block.type === 'contact' ? block.inquiryTopics : undefined} consentLabel={block.type === 'contact' ? block.inquiryConsentLabel : undefined} />}</>)}
  {(route.page.template === 'listing' || (['pillar', 'service'].includes(route.page.template) && children.length > 0)) && <section class="block"><div class="block__inner"><h2>{route.page.template === 'listing' ? 'Pages' : 'Child pages'}</h2>{children.length ? <ul>{children.map((child) => <li><a href={localURL(child.path)}>{child.page.title}</a><p>{child.page.summary}</p>{child.page.businessCase && <p><strong>Case study</strong> · {child.page.businessCase.industry} · {child.page.businessCase.services.join(', ')}</p>}</li>)}</ul> : <p>No child pages are published.</p>}</div></section>}
  {route.page.template === 'article' && <aside class="block"><div class="block__inner"><h2>Article information</h2><p>{route.page.summary}</p>{(route.page.publishedAt || route.page.lastReviewed) && <dl>{route.page.publishedAt && <><dt>Published</dt><dd><time datetime={route.page.publishedAt}>{route.page.publishedAt.slice(0, 10)}</time></dd></>}{route.page.lastReviewed && <><dt>Last reviewed</dt><dd><time datetime={route.page.lastReviewed}>{route.page.lastReviewed.slice(0, 10)}</time></dd></>}</dl>}{route.page.businessCase && <section aria-label="Case study details"><h2>Case study</h2><dl><dt>Client</dt><dd>{route.page.businessCase.client ?? route.page.businessCase.anonymizedClient}</dd><dt>Industry</dt><dd>{route.page.businessCase.industry}</dd><dt>Published</dt><dd><time datetime={route.page.businessCase.publicationDate}>{route.page.businessCase.publicationDate.slice(0, 10)}</time></dd><dt>Challenge</dt><dd>{route.page.businessCase.challenge}</dd><dt>Approach</dt><dd>{route.page.businessCase.approach}</dd><dt>Outcome</dt><dd>{route.page.businessCase.outcome}</dd><dt>Services</dt><dd>{route.page.businessCase.services.join(', ')}</dd></dl></section>}</div></aside>}
  {route.page.template === 'job' && route.page.jobPosting && <section class="block"><div class="block__inner"><h2>Application information</h2><dl><dt>Employment type</dt><dd>{route.page.jobPosting.employmentType.replaceAll('_', ' ').toLowerCase()}</dd><dt>Location</dt><dd>{[route.page.jobPosting.location.addressLocality, route.page.jobPosting.location.addressRegion, route.page.jobPosting.location.addressCountry].filter(Boolean).join(', ')}</dd><dt>Posted</dt><dd><time datetime={route.page.jobPosting.datePosted}>{route.page.jobPosting.datePosted.slice(0, 10)}</time></dd>{route.page.jobPosting.validThrough && <><dt>Closing date</dt><dd><time datetime={route.page.jobPosting.validThrough}>{route.page.jobPosting.validThrough.slice(0, 10)}</time></dd></>}</dl><h2>Apply for this role</h2><ApplicationForm jobId={route.page.id} enabled={applicationsEnabled} /></div></section>}
  <MotionRuntime enabled={motionEnabled} />
  {AnalyticsHooks && <AnalyticsHooks path={route.path} />}
</Layout>

<style>
  /* Breadcrumbs belong to the host, including their minimum touch targets
     when a theme supplies its own layout and typography. */
  nav[aria-label="Breadcrumb"] ol { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; list-style: none; padding: 0; }
  nav[aria-label="Breadcrumb"] a { display: inline-flex; align-items: center; min-height: 2.75rem; padding-inline: .25rem; }
</style>
