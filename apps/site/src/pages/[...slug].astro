---
import Layout from '@site-engine/theme-starter/components/Layout.astro';
import BlockRenderer from '@site-engine/theme-starter/components/BlockRenderer.astro';
import { childrenOf, deriveRoutes } from '@site-engine/engine';
import { localURL, siteHomepageId, siteSnapshot } from '../lib/snapshot.js';
import MotionRuntime from '../components/MotionRuntime.astro';
import { pageHasEnabledMotion, resolveStarterMotion } from '../lib/motion.js';
import { crawlerMode } from '../lib/crawler-config.js';
import { publicOrigin, renderBase } from '../lib/snapshot.js';
import { schemaForRoute } from '../lib/seo.js';
import ApplicationForm from '../components/ApplicationForm.astro';
import InquiryForm from '../components/InquiryForm.astro';
const model = deriveRoutes(siteSnapshot, siteHomepageId);
export function getStaticPaths() { const staticModel = deriveRoutes(siteSnapshot, siteHomepageId); return staticModel.routes.filter((route) => route.path !== '/').map((route) => ({ params: { slug: route.path.slice(1) }, props: { route } })); }
const { route } = Astro.props;
const children = childrenOf(route, model);
const motionEnabled = pageHasEnabledMotion(route.page.blocks);
const applicationsEnabled = renderBase === '/';
const preview = crawlerMode(renderBase) === 'preview';
const searchEnabled = !preview && siteSnapshot.settings.searchEnabled;
const analyticsConfigured = !preview && (() => { try { const endpoint = new URL(process.env.PUBLIC_ANALYTICS_ENDPOINT ?? ''); return endpoint.protocol === 'https:' && !endpoint.username && !endpoint.password; } catch { return false; } })();
const AnalyticsHooks = analyticsConfigured ? (await import('../components/AnalyticsHooks.astro')).default : undefined;
---
<Layout route={route} model={model} snapshot={siteSnapshot} title={route.page.title} description={route.page.seoDescription ?? route.page.summary} motionEnabled={motionEnabled} noindex={preview || route.page.noindex} searchEnabled={searchEnabled} schema={schemaForRoute(route, model, siteSnapshot, publicOrigin)}>
  <nav aria-label="Breadcrumb"><ol>{route.breadcrumbs.map((crumb, index) => <li>{index === route.breadcrumbs.length - 1 ? <span aria-current="page">{crumb.label}</span> : <a href={localURL(crumb.href)}>{crumb.label}</a>}</li>)}</ol></nav>
  {!route.page.blocks.some((block) => !block.hidden && block.type === 'hero') && <header class="block"><div class="block__inner"><h1>{route.page.title}</h1><p>{route.page.summary}</p></div></header>}
  {route.page.blocks.map((block) => <><BlockRenderer block={block} snapshot={siteSnapshot} model={model} motionPreset={resolveStarterMotion(block)} />{!block.hidden && block.type === 'contact' && block.inquiryForm && <InquiryForm enabled={renderBase === '/'} />}</>)}
  {['listing', 'pillar', 'service'].includes(route.page.template) && <section class="block"><div class="block__inner"><h2>{route.page.template === 'listing' ? 'Pages' : 'Child pages'}</h2>{children.length ? <ul>{children.map((child) => <li><a href={localURL(child.path)}>{child.page.title}</a><p>{child.page.summary}</p></li>)}</ul> : <p>No child pages are published.</p>}</div></section>}
  {route.page.template === 'article' && <aside class="block"><div class="block__inner"><h2>Article information</h2><p>{route.page.summary}</p></div></aside>}
  {route.page.template === 'job' && route.page.jobPosting && <section class="block"><div class="block__inner"><h2>Application information</h2><dl><dt>Employment type</dt><dd>{route.page.jobPosting.employmentType.replaceAll('_', ' ').toLowerCase()}</dd><dt>Location</dt><dd>{[route.page.jobPosting.location.addressLocality, route.page.jobPosting.location.addressRegion, route.page.jobPosting.location.addressCountry].filter(Boolean).join(', ')}</dd><dt>Posted</dt><dd><time datetime={route.page.jobPosting.datePosted}>{route.page.jobPosting.datePosted.slice(0, 10)}</time></dd>{route.page.jobPosting.validThrough && <><dt>Closing date</dt><dd><time datetime={route.page.jobPosting.validThrough}>{route.page.jobPosting.validThrough.slice(0, 10)}</time></dd></>}</dl><h2>Apply for this role</h2><ApplicationForm jobId={route.page.id} enabled={applicationsEnabled} /></div></section>}
  <MotionRuntime enabled={motionEnabled} />
  {AnalyticsHooks && <AnalyticsHooks path={route.path} />}
</Layout>

<style>
  /* Breadcrumbs belong to the host, including their minimum touch targets
     when a theme supplies its own layout and typography. */
  nav[aria-label="Breadcrumb"] ol { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; list-style: none; padding: 0; }
  nav[aria-label="Breadcrumb"] a { display: inline-flex; align-items: center; min-height: 2.75rem; padding-inline: .25rem; }
</style>
