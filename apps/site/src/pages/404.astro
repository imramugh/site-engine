---
import Layout from '@site-engine/theme-starter/components/Layout.astro';
import { deriveRoutes } from '@site-engine/engine';
import { localURL, renderBase, siteHomepageId, siteSnapshot } from '../lib/snapshot.js';
import { crawlerMode } from '../lib/crawler-config.js';
const model = deriveRoutes(siteSnapshot, siteHomepageId);
const searchEnabled = crawlerMode(renderBase) !== 'preview' && siteSnapshot.settings.searchEnabled;
---
<Layout model={model} snapshot={siteSnapshot} title="Page not found" description="The requested page is unavailable." noindex={true} searchEnabled={searchEnabled}><section class="block"><div class="block__inner"><h1>Page not found</h1><p>The requested page is not available.</p><a href={localURL('/')}>Return home</a></div></section></Layout>
