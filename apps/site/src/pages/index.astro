---
import Layout from '@site-engine/theme-starter/components/Layout.astro';
import BlockRenderer from '@site-engine/theme-starter/components/BlockRenderer.astro';
import { deriveRoutes } from '@site-engine/engine';
import { demoHomepageId, demoSnapshot } from '../lib/demo.js';
const model = deriveRoutes(demoSnapshot, demoHomepageId);
const route = model.byPath.get('/');
if (!route) throw new Error('The configured demo homepage is not published.');
---
<Layout route={route} model={model} snapshot={demoSnapshot} title={route.page.title} description={route.page.summary}>
  {route.page.blocks.map((block) => <BlockRenderer block={block} snapshot={demoSnapshot} model={model} />)}
</Layout>
