# Runtime data and secrets stay outside Git. This example contains no usable secrets.
DATABASE_URI=file:./data/cms.sqlite
PAYLOAD_SECRET=replace-with-a-32-character-minimum-random-secret
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
# Mount a root-readable one-time token file only while creating the initial owner.
BOOTSTRAP_OPERATOR_TOKEN_FILE=/run/secrets/cms_bootstrap_operator_token
# OIDC providers stay unavailable unless all matching variables are configured.
OIDC_GOOGLE_ISSUER_URL=https://accounts.google.com
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_MICROSOFT_ISSUER_URL=
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=

# Required only when an emergency Owner credential is provisioned (32 random bytes, base64url).
EMERGENCY_TOTP_ENCRYPTION_KEY=
