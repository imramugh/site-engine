PORT=3001
OAUTH_ISSUER=https://example.test/oauth
OAUTH_DATABASE_PATH=/var/lib/site-engine/oauth.sqlite
OAUTH_COOKIE_KEYS=replace-with-two-random-values
OAUTH_RESOURCE=https://example.test/mcp
# A valid private RSA, EC, OKP, or AKP signing JWK set from the deployment secret store.
OAUTH_JWKS=
# Both bridge settings are required to resolve private CMS sessions. Without
# them, authorization remains denied.
# OAUTH_CMS_ORIGIN=http://cms:3001
# OAUTH_BRIDGE_SECRET=replace-with-a-random-shared-secret
# OAUTH_INTROSPECTION_SECRET=replace-with-a-separate-random-internal-secret
