{
  "name": "@site-engine/theme-conformance",
  "version": "1.0.8",
  "description": "Neutral, installable visual and accessibility conformance harness for Site Engine themes.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": { ".": "./src/index.mjs" },
  "bin": { "site-engine-theme-conformance": "./scripts/theme-conformance.mjs" },
  "files": ["src", "scripts", "harness", "baselines.json", "README.md"],
  "scripts": {
    "conformance": "node scripts/theme-conformance.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "node --check src/index.mjs && node --check harness/build-snapshot.mjs",
    "lint": "node --check src/index.mjs && node --check harness/build-snapshot.mjs"
  },
  "dependencies": {
    "@site-engine/contract": "workspace:^",
    "@site-engine/engine": "workspace:^",
    "@site-engine/theme-starter": "workspace:^",
    "astro": "7.3.8",
    "axe-core": "4.14.0",
    "@playwright/test": "1.64.0"
  }
}
