---
import type { PublicRoute, RouteModel, SiteSnapshot } from '@site-engine/contract';
const { route, model, snapshot, title, description } = Astro.props as { route?: PublicRoute; model: RouteModel; snapshot: SiteSnapshot; title: string; description: string };
const services = model.routes.filter((item) => item.page.template === 'service').sort((a, b) => a.page.title.localeCompare(b.page.title));
const primary = model.routes.filter((item) => item.path !== '/').filter((item) => item.page.template === 'listing' || item.page.template === 'pillar' || item.page.template === 'standard').slice(0, 6);
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={route?.canonicalPath ?? Astro.url.pathname} /></head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  <header class="site-header starter-header"><a class="wordmark" href="/">{snapshot.settings.siteName}</a><nav aria-label="Primary"><a href="/">Home</a>{primary.map((item) => <a href={item.path}>{item.page.title}</a>)}{services.slice(0, 6).map((service) => <a href={service.path}>{service.page.title}</a>)}</nav></header>
  <main id="content"><slot /></main>
  <footer class="site-footer"><nav aria-label="Footer">{model.routes.filter((item) => item.path !== '/').map((item) => <a href={item.path}>{item.page.title}</a>)}</nav><small>Synthetic content for public engine validation.</small></footer>
</body></html>
<style is:global>
  :root { font-family: system-ui, sans-serif; color: #14212b; background: #fff; line-height: 1.5; } * { box-sizing: border-box; } body { margin: 0; } a { color: #064f85; } a:focus-visible { outline: 3px solid #e47d22; outline-offset: 3px; } .skip-link { position: fixed; left: .75rem; top: .75rem; transform: translateY(-200%); background: #fff; padding: .5rem; z-index: 2; } .skip-link:focus { transform: none; } .site-header,.site-footer { padding: 1rem max(1rem, calc((100vw - 70rem)/2)); display:flex; gap:1rem; align-items:center; flex-wrap:wrap; } .site-header { border-bottom: 1px solid #ccd5da; } .wordmark { color:#14212b; font-weight:700; text-decoration:none; } nav { display:flex; flex-wrap:wrap; gap:.75rem; } .site-footer { border-top:1px solid #ccd5da; margin-top:2rem; } .block { padding: clamp(1.5rem, 4vw, 4rem) max(1rem, calc((100vw - 70rem)/2)); } .block--subtle { background:#f1f5f6; }.block--brand { background:#064f85; color:#fff; }.block--accent { background:#d9edf7; }.block--highlight { background:#fff4cf; }.block--inverse { background:#14212b; color:#fff; }.block--wide .block__inner { max-width:70rem; }.block--content .block__inner { max-width:48rem; }.block--full .block__inner { max-width:none; }.block__inner { margin:auto; }.block--compact { padding-top:1rem; padding-bottom:1rem; }.block--spacious { padding-top:5rem; padding-bottom:5rem; } .cards { display:grid; gap:1rem; grid-template-columns:repeat(auto-fit,minmax(14rem,1fr)); list-style:none; padding:0; }.card { border:1px solid #ccd5da; padding:1rem; }.media { max-width:100%; height:auto; }.split { display:grid; gap:1rem; grid-template-columns:repeat(auto-fit,minmax(15rem,1fr)); }.chips { display:flex; gap:.5rem; flex-wrap:wrap; list-style:none; padding:0; }.chips li { border:1px solid currentColor; border-radius:99px; padding:.25rem .65rem; }.quote { border-left:4px solid #e47d22; padding-left:1rem; }.video { width:100%; max-width:48rem; } @media (prefers-reduced-motion: reduce) { *,*::before,*::after { scroll-behavior:auto !important; animation-duration:0.01ms !important; } }
</style>
