---
import type { PublicRoute, RouteModel, SiteSnapshot } from '@site-engine/contract';
import { headerServiceNavigation, serviceNavigation } from '@site-engine/engine';
const { route, model, snapshot, title, description, motionEnabled = false, noindex = false, searchEnabled = false, schema } = Astro.props as { route?: PublicRoute; model: RouteModel; snapshot: SiteSnapshot; title: string; description: string; motionEnabled?: boolean; noindex?: boolean; searchEnabled?: boolean; schema?: unknown };
const base = import.meta.env.SITE_BASE_PATH && import.meta.env.SITE_BASE_PATH !== '/' ? `/${import.meta.env.SITE_BASE_PATH.replace(/^\/+|\/+$/g, '')}` : '';
const link = (href: string) => /^(?:[a-z][a-z0-9+.-]*:|#|\/\/)/i.test(href) ? href : `${base}${href}`;
const canonical = new URL(route?.canonicalPath ?? Astro.url.pathname, import.meta.env.SITE_PUBLIC_ORIGIN ?? 'https://example.invalid').href;
const services = serviceNavigation(model);
const headerServices = headerServiceNavigation(model);
const primary = model.routes.filter((item) => item.path !== '/').filter((item) => item.page.template === 'listing' || item.page.template === 'pillar' || item.page.template === 'standard').slice(0, 6);
const showSyntheticFooter = !import.meta.env.SITE_SNAPSHOT_PATH;
---
<!doctype html><html lang="en" data-motion="allow"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />{noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}{schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />}</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  <header class="site-header starter-header"><a class="wordmark" href={link('/')}>{snapshot.settings.siteName}</a><nav aria-label="Primary"><a href={link('/')}>Home</a>{primary.map((item) => <a href={link(item.path)}>{item.page.title}</a>)}{headerServices.map((service) => <a href={link(service.path)}>{service.page.title}</a>)}{searchEnabled && <a href={link('/search')}>Search</a>}</nav></header>
  <main id="content"><slot /></main>
  <footer class="site-footer"><nav aria-label="Footer services">{services.map((service) => <a href={link(service.path)}>{service.page.title}</a>)}</nav>{motionEnabled && <button type="button" data-motion-toggle aria-pressed="false">Reduce motion</button>}{showSyntheticFooter && <small>Synthetic content for public engine validation.</small>}</footer>
</body></html>
<style is:global>
  :root { font-family: system-ui, sans-serif; color: #14212b; background: #fff; line-height: 1.5; } * { box-sizing: border-box; } body { margin: 0; } a { color: #064f85; } a:focus-visible,button:focus-visible { outline: 3px solid #e47d22; outline-offset: 3px; } .skip-link { position: fixed; left: .75rem; top: .75rem; transform: translateY(-200%); background: #fff; padding: .5rem; z-index: 2; } .skip-link:focus { transform: none; } .site-header,.site-footer { padding: 1rem max(1rem, calc((100vw - 70rem)/2)); display:flex; gap:1rem; align-items:center; flex-wrap:wrap; } .site-header { border-bottom: 1px solid #ccd5da; } .wordmark { color:#14212b; font-weight:700; text-decoration:none; } nav { display:flex; flex-wrap:wrap; gap:.75rem; } .site-footer { border-top:1px solid #ccd5da; margin-top:2rem; } .block { padding: clamp(1.5rem, 4vw, 4rem) max(1rem, calc((100vw - 70rem)/2)); } .block--subtle { background:#f1f5f6; }.block--brand { background:#064f85; color:#fff; }.block--accent { background:#d9edf7; }.block--highlight { background:#fff4cf; }.block--inverse { background:#14212b; color:#fff; }.block--wide .block__inner { max-width:70rem; }.block--content .block__inner { max-width:48rem; }.block--full .block__inner { max-width:none; }.block__inner { margin:auto; }.block--compact { padding-top:1rem; padding-bottom:1rem; }.block--spacious { padding-top:5rem; padding-bottom:5rem; } .hero { display:grid; gap:1.5rem; }.hero--with-panel { grid-template-columns:minmax(0, 2fr) minmax(16rem, 1fr); align-items:start; }.hero__actions { display:flex; flex-wrap:wrap; gap:1rem; margin-top:1.5rem; }.hero__support { border:1px solid currentColor; padding:1.25rem; }.hero__support > :first-child { margin-top:0; }.hero__eyebrow { font-weight:700; letter-spacing:.04em; text-transform:uppercase; } @media (max-width: 42rem) { .hero--with-panel { grid-template-columns:1fr; } } .cards { display:grid; gap:1rem; grid-template-columns:repeat(auto-fit,minmax(14rem,1fr)); list-style:none; padding:0; }.card { border:1px solid #ccd5da; padding:1rem; }.media { max-width:100%; height:auto; }.split { display:grid; gap:1rem; grid-template-columns:repeat(auto-fit,minmax(15rem,1fr)); }.chips { display:flex; gap:.5rem; flex-wrap:wrap; list-style:none; padding:0; }.chips li { border:1px solid currentColor; border-radius:99px; padding:.25rem .65rem; }.quote { border-left:4px solid #e47d22; padding-left:1rem; }.video { width:100%; max-width:48rem; } @keyframes starter-motion { 50% { transform: translateY(-0.2rem); } } [data-motion-effect] { animation: starter-motion 2s ease-in-out infinite; animation-play-state: paused; } html[data-motion="allow"] [data-motion-effect][data-motion-paused="false"] { animation-play-state: running; }
</style>
