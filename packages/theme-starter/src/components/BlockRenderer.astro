---
import type { Block, RouteModel, SiteSnapshot } from '@site-engine/contract';
const { block, snapshot, model, motionPreset, hostInquiryRendered = false } = Astro.props as { block: Block; snapshot: SiteSnapshot; model: RouteModel; motionPreset?: string; hostInquiryRendered?: boolean };
const base = import.meta.env.SITE_BASE_PATH && import.meta.env.SITE_BASE_PATH !== '/' ? `/${import.meta.env.SITE_BASE_PATH.replace(/^\/+|\/+$/g, '')}` : '';
// Contract validation rejects unsafe URLs. Retain this guard at the rendering
// boundary so a renderer is safe even if it receives malformed data directly.
const href = (value: string) => /^\/(?!\/)(?!.*[\\\u0000-\u001f?])[A-Za-z0-9/_-]*(?:#[a-z][a-z0-9-]{0,63})?$/.test(value) ? `${base}${value}` : '#';
const phoneHref = (value: string) => /^\+[1-9]\d{6,14}$/.test(value) ? `tel:${value}` : '#';
const contactHref = (value: string) => {
  if (/[#?%\s\p{Cc}]/u.test(value)) return '#';
  if (/^tel:\+[1-9]\d{6,14}$/.test(value) || /^mailto:[^\s@]+@[^\s@]+\.[^\s@]+$/i.test(value)) return value;
  try { const url = new URL(value); return url.protocol === 'https:' && !url.username && !url.password && !url.search && !url.hash && /^\/[A-Za-z0-9._~/-]*$/.test(url.pathname) ? value : '#'; } catch { return '#'; }
};
const media = new Map(snapshot.media.map((item) => [item.id, item]));
const mediaSrc = (id: string) => `${base}/media/${media.get(id)?.filename ?? 'missing.svg'}`;
const resolved = (id: string) => media.get(id);
const focalStyle = (id: string) => {
  const item = resolved(id);
  return item?.focalX === undefined || item.focalY === undefined ? undefined : `object-position:${item.focalX}% ${item.focalY}%`;
};
const image = (id: string, slot: 'hero' | 'card' | 'thumbnail' = 'card') => {
  const item = resolved(id);
  if (!item) return null;
  const alt = item.decorative ? '' : item.alt;
  const avif = item.variants?.[`${slot}Avif` as 'heroAvif'];
  const webp = item.variants?.[`${slot}Webp` as 'heroWebp'];
  const preservesAspect = (variant?: { filename: string; width: number; height: number }) => Boolean(variant && item.width && item.height && Math.abs(variant.width / variant.height - item.width / item.height) < 0.01);
  return {
    item, alt,
    avif: avif?.filename ? `${base}/media/${avif.filename}` : undefined,
    webp: webp?.filename ? `${base}/media/${webp.filename}` : undefined,
    cropAvif: preservesAspect(avif) ? `${base}/media/${avif!.filename}` : undefined,
    cropWebp: preservesAspect(webp) ? `${base}/media/${webp!.filename}` : undefined,
  };
};
const classes = `block block--${block.appearance.background} block--${block.appearance.width} block--${block.appearance.spacing} block--logo-${block.appearance.logoTone}`;
const related = block.type === 'relatedServices' ? block.pageIds.map((id) => model.routes.find((route) => route.page.id === id)).filter(Boolean) : [];
const approvedTestimonials = block.type === 'testimonials' ? block.items.filter((item) => item.permissionConfirmed) : [];
const paragraphs = block.type === 'richText' ? block.body.split(/\n\s*\n/).filter(Boolean) : [];
const effect = ['contact', 'incidentBar'].includes(block.type) ? undefined : motionPreset;
---
{!block.hidden && <section class={classes} id={block.anchorId} data-block={block.type} data-block-id={block.id} data-background={block.appearance.background} data-logo-tone={block.appearance.logoTone} data-motion-intent={block.appearance.motionIntent} data-motion-effect={effect}><div class="block__inner">
  {block.type === 'hero' && <div class:list={['hero', { 'hero--with-panel': Boolean(block.supportPanel) }]}><div class="hero__content">{block.eyebrow && <p class="hero__eyebrow">{block.eyebrow}</p>}<h1>{block.heading}</h1><p>{block.body}</p>{(block.cta || block.secondaryCta || block.phoneCta) && <div class="hero__actions">{block.cta && <a data-primary-cta href={href(block.cta.href)}>{block.cta.label}</a>}{block.secondaryCta && <a data-secondary-cta href={href(block.secondaryCta.href)}>{block.secondaryCta.label}</a>}{block.phoneCta && <a data-phone-cta href={phoneHref(block.phoneCta.number)}>{block.phoneCta.label}</a>}</div>}</div>{block.supportPanel && <aside class="hero__support" aria-label={block.supportPanel.heading}>{block.supportPanel.eyebrow && <p class="hero__eyebrow">{block.supportPanel.eyebrow}</p>}<h2>{block.supportPanel.heading}</h2><p>{block.supportPanel.body}</p>{block.supportPanel.cta && <a href={href(block.supportPanel.cta.href)}>{block.supportPanel.cta.label}</a>}{block.supportPanel.phoneCta && <a data-phone-cta href={phoneHref(block.supportPanel.phoneCta.number)}>{block.supportPanel.phoneCta.label}</a>}</aside>}</div>}
  {block.type === 'incidentBar' && <p role="status">{block.message} {block.cta && <a href={href(block.cta.href)}>{block.cta.label}</a>}</p>}
  {block.type === 'pillarGrid' && <>{block.eyebrow && <p class="hero__eyebrow">{block.eyebrow}</p>}<h2>{block.heading}</h2>{block.body && <p>{block.body}</p>}<ul class="cards">{block.items.map((item) => <li class="card"><h3><a href={href(item.href)}>{item.title}</a></h3><p>{item.body}</p>{item.links?.map((link) => <a href={href(link.href)}>{link.label}</a>)}</li>)}</ul></>}
  {block.type === 'featureGrid' && <>{block.eyebrow && <p class="hero__eyebrow">{block.eyebrow}</p>}<h2>{block.heading}</h2>{block.body && <p>{block.body}</p>}<ul class="cards">{block.items.map((item) => <li class="card"><h3>{item.title}</h3><p>{item.body}</p></li>)}</ul></>}
  {block.type === 'splitList' && <>{block.eyebrow && <p class="hero__eyebrow">{block.eyebrow}</p>}<h2>{block.heading}</h2>{block.body && <p>{block.body}</p>}<ol class="split">{block.items.map((item) => <li><h3>{item.title}</h3><p>{item.body}</p></li>)}</ol></>}
  {block.type === 'chipList' && <>{block.eyebrow && <p class="hero__eyebrow">{block.eyebrow}</p>}{block.heading && <h2>{block.heading}</h2>}{block.body && <p>{block.body}</p>}<ul class="chips">{block.chips.map((chip) => <li>{chip}</li>)}</ul></>}
  {block.type === 'testimonials' && approvedTestimonials.length > 0 && <><h2>Testimonials</h2>{approvedTestimonials.map((item) => <figure class="quote"><blockquote>{item.quote}</blockquote><figcaption>{item.attribution}{item.role && `, ${item.role}`}</figcaption></figure>)}</>}
  {block.type === 'faq' && <>{block.eyebrow && <p class="hero__eyebrow">{block.eyebrow}</p>}<h2>{block.heading}</h2>{block.body && <p>{block.body}</p>}{block.items.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</>}
  {block.type === 'callout' && <>{block.eyebrow && <p class="hero__eyebrow">{block.eyebrow}</p>}<h2>{block.heading}</h2><p>{block.body}</p>{block.items && block.items.length > 0 && <ul>{block.items.map((item) => <li>{item}</li>)}</ul>}{block.cta && <a href={href(block.cta.href)}>{block.cta.label}</a>}</>}
  {block.type === 'relatedServices' && <><h2>{block.heading}</h2><ul>{related.map((route) => route && <li><a href={href(route.path)}>{route.page.title}</a><p>{route.page.summary}</p></li>)}{block.links?.map((link) => <li><a href={href(link.href)}>{link.label}</a></li>)}</ul></>}
  {block.type === 'cta' && <><h2>{block.heading}</h2><p>{block.body}</p><a href={href(block.cta.href)}>{block.cta.label}</a></>}
  {block.type === 'richText' && <>{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</>}
  {block.type === 'contact' && <>{!hostInquiryRendered && <h2>{block.heading}</h2>}<p>{block.body}</p>{block.contactDetails?.incidentCallout && <aside aria-label={block.contactDetails.incidentCallout.label}><strong>{block.contactDetails.incidentCallout.label}</strong><p>{block.contactDetails.incidentCallout.body}</p>{block.contactDetails.incidentCallout.phoneLabel && snapshot.settings.contactPhone && <a href={phoneHref(snapshot.settings.contactPhone)}>{block.contactDetails.incidentCallout.phoneLabel}</a>}</aside>}{Boolean(block.contactDetails?.channels?.length) && <dl>{block.contactDetails?.channels?.map((channel) => <><dt>{channel.label}</dt><dd>{channel.href ? <a href={contactHref(channel.href)}>{channel.value}</a> : channel.value}</dd></>)}</dl>}{Boolean(block.contactDetails?.nextSteps?.length) && <>{block.contactDetails?.nextStepsHeading && <h3>{block.contactDetails.nextStepsHeading}</h3>}<ol>{block.contactDetails?.nextSteps?.map((step) => <li>{block.contactDetails?.nextStepsHeading ? <h4>{step.title}</h4> : <h3>{step.title}</h3>}<p>{step.body}</p></li>)}</ol></>}</>}
  {block.type === 'media' && image(block.mediaId, 'hero') && <figure><picture class="media-frame media-frame--wide">{image(block.mediaId, 'hero')!.cropAvif && <source srcset={image(block.mediaId, 'hero')!.cropAvif} type="image/avif" />}{image(block.mediaId, 'hero')!.cropWebp && <source srcset={image(block.mediaId, 'hero')!.cropWebp} type="image/webp" />}<img class="media" src={mediaSrc(block.mediaId)} width={image(block.mediaId, 'hero')!.item.width} height={image(block.mediaId, 'hero')!.item.height} alt={image(block.mediaId, 'hero')!.alt} style={focalStyle(block.mediaId)} /></picture>{block.caption && <figcaption>{block.caption}</figcaption>}</figure>}
  {block.type === 'imageText' && image(block.mediaId, 'card') && <div class="split"><picture class="media-frame media-frame--portrait">{image(block.mediaId, 'card')!.cropAvif && <source srcset={image(block.mediaId, 'card')!.cropAvif} type="image/avif" />}{image(block.mediaId, 'card')!.cropWebp && <source srcset={image(block.mediaId, 'card')!.cropWebp} type="image/webp" />}<img class="media" src={mediaSrc(block.mediaId)} width={image(block.mediaId, 'card')!.item.width} height={image(block.mediaId, 'card')!.item.height} alt={image(block.mediaId, 'card')!.alt} style={focalStyle(block.mediaId)} /></picture><div><h2>{block.heading}</h2><p>{block.body}</p></div></div>}
  {block.type === 'gallery' && <ul class="cards">{block.mediaIds.map((id) => image(id, 'thumbnail') && <li><picture class="media-frame media-frame--square">{image(id, 'thumbnail')!.cropAvif && <source srcset={image(id, 'thumbnail')!.cropAvif} type="image/avif" />}{image(id, 'thumbnail')!.cropWebp && <source srcset={image(id, 'thumbnail')!.cropWebp} type="image/webp" />}<img class="media" src={mediaSrc(id)} width={image(id, 'thumbnail')!.item.width} height={image(id, 'thumbnail')!.item.height} alt={image(id, 'thumbnail')!.alt} style={focalStyle(id)} /></picture></li>)}</ul>}
  {block.type === 'logoStrip' && <ul class="cards">{block.mediaIds.map((id) => image(id, 'thumbnail') && <li><picture class="logo-media">{image(id, 'thumbnail')!.avif && <source srcset={image(id, 'thumbnail')!.avif} type="image/avif" />}{image(id, 'thumbnail')!.webp && <source srcset={image(id, 'thumbnail')!.webp} type="image/webp" />}<img class="media" src={mediaSrc(id)} width={image(id, 'thumbnail')!.item.width} height={image(id, 'thumbnail')!.item.height} alt={image(id, 'thumbnail')!.alt} /></picture></li>)}</ul>}
  {block.type === 'video' && <><video class="video" controls poster={mediaSrc(block.posterMediaId)} aria-label={resolved(block.mediaId)?.alt}><source src={mediaSrc(block.mediaId)} type={resolved(block.mediaId)?.mimeType} /><track kind="captions" src={mediaSrc(block.captionsMediaId)} srclang="en" label="English" default />Your browser does not support video.</video>{block.transcript && <details><summary>Transcript</summary><p>{block.transcript}</p></details>}</>}
</div></section>}
